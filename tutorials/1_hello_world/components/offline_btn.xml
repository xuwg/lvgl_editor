<component>
    <api>
        <prop name="text" type="string" default="Network" />
        <prop name="image" type="string" default="" />
        <prop name="width" type="string" default="300" />
        <prop name="height" type="string" default="50" />
    </api>

    <consts />

    <styles>
        <style name="normal" border_color="0x000" />
        <style name="checked" border_color="0x00ff00" border_width="1" />
    </styles>
    <view extends="lv_button" width="$width" height="$height" flex_flow="row" style_flex_cross_place="center" style_border_width="1" style_bg_color="0xfff" style_radius="3">
        <style name="normal" selector="normal|main" />
        <style name="checked" selector="checked|main" />
        <lv_image src="$image" />
        <lv_label text="$text" style_text_color="0x000" />
        <lv_obj height="100%" style_opa="0" flex_grow="1" />
    </view>
</component>
